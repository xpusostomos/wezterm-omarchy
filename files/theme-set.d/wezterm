#!/bin/bash
# managed by wezterm-omarchy
#
# Omarchy runs everything in ~/.config/omarchy/hooks/theme-set.d/ after each
# `omarchy theme set`.
#
# WezTerm normally reloads by itself: the generated theme file is on its config
# reload watch list (see the add_to_config_reload_watch_list call in wezterm.lua).
# This hook is a fallback for WezTerm builds that lack that function -- touching
# the main config makes WezTerm re-evaluate it, which re-reads the theme.

set -euo pipefail

config="${XDG_CONFIG_HOME:-$HOME/.config}/wezterm/wezterm.lua"

if [[ -f $config ]]; then
  touch "$config"
fi
